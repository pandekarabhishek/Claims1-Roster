@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * { box-sizing: border-box; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #484f58; }

  body {
    font-family: 'DM Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
    background: #0d1117;
    color: #e6edf3;
    overflow: hidden;
    height: 100vh;
  }

  #root { height: 100vh; display: flex; }

  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.6);
    cursor: pointer;
  }

  select option { background: #1c2128; color: #e6edf3; }
}

@layer components {
  .input-base {
    @apply bg-surface-2 border border-white/10 rounded-md px-3 py-2 text-sm text-white/90
           outline-none transition-colors w-full font-sans
           focus:border-brand-500 placeholder:text-white/30;
  }
  .btn-base {
    @apply inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md text-xs font-medium
           transition-all cursor-pointer border select-none;
  }
  .btn-ghost {
    @apply btn-base bg-transparent border-white/10 text-white/50
           hover:text-white/80 hover:bg-white/5 hover:border-white/20;
  }
  .btn-solid {
    @apply btn-base bg-brand-500 border-brand-500 text-white
           hover:bg-brand-400 hover:border-brand-400;
  }
  .btn-outline {
    @apply btn-base bg-surface-2 border-white/10 text-white/60
           hover:text-white/90 hover:bg-surface-3 hover:border-white/20;
  }
  .card {
    @apply bg-surface-1 border border-white/[0.06] rounded-xl;
  }
  .badge {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium;
  }
  .nav-item {
    @apply flex items-center gap-2.5 px-2.5 py-2 rounded-md text-[13px] cursor-pointer
           text-white/40 transition-all select-none;
  }
  .nav-item:hover { @apply bg-white/5 text-white/70; }
  .nav-item.active { @apply bg-brand-500/10 text-brand-400 font-medium; }
  .stat-card {
    @apply bg-surface-1 border border-white/[0.06] rounded-xl p-4
           hover:border-white/10 transition-colors;
  }
}
