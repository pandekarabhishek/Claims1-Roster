import { useState } from 'react'
import { Plus, Search } from 'lucide-react'
import Sidebar      from './components/Sidebar'
import Dashboard    from './components/Dashboard'
import Calendar     from './components/Calendar'
import Availability from './components/Availability'
import AllLeaves    from './components/AllLeaves'
import Roster       from './components/Roster'
import LogLeaveModal from './components/LogLeaveModal'
import { useLeaves }  from './hooks/useLeaves'
import { useToast }   from './hooks/useToast'
import { TYPE_LABELS } from './data/team'
import { dayCount }    from './utils'

const TITLES = {
  dashboard:    'Dashboard',
  calendar:     'Calendar',
  availability: 'Availability',
  leaves:       'All leaves',
  roster:       'Roster',
}

export default function App() {
  const [screen,     setScreen]     = useState('dashboard')
  const [modalOpen,  setModalOpen]  = useState(false)
  const [defaultEmp, setDefaultEmp] = useState('')
  const [gsearch,    setGsearch]    = useState('')

  const { leaves, loading, dbStatus, addLeave, deleteLeave } = useLeaves()
  const toast = useToast()

  async function handleSave(data) {
    const result = await addLeave(data)
    if (result.success) {
      const n = dayCount(result.entry)
      toast(`${n} day${n > 1 ? 's' : ''} of ${TYPE_LABELS[data.type]} saved for ${data.emp.split(' ')[0]}`)
    } else {
      toast('Failed to save leave: ' + result.error, 'error')
    }
  }

  async function handleDelete(id) {
    const result = await deleteLeave(id)
    if (result.success) toast('Leave entry removed', 'info')
    else toast('Failed to delete: ' + result.error, 'error')
  }

  function openModalFor(emp = '') {
    setDefaultEmp(emp)
    setModalOpen(true)
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center w-full h-screen bg-surface-0">
        <div className="flex flex-col items-center gap-3">
          <div className="w-8 h-8 rounded-[9px] bg-brand-500 flex items-center justify-center
            text-[13px] font-bold text-white animate-pulse-dot">TP</div>
          <div className="text-[13px] text-white/30">Loading TeamPulse…</div>
        </div>
      </div>
    )
  }

  return (
    <div className="flex h-screen overflow-hidden bg-surface-0">
      <Sidebar
        active={screen}
        onNav={setScreen}
        leaveCount={leaves.length}
        dbStatus={dbStatus}
        onLogLeave={() => openModalFor()}
      />

      <div className="flex flex-col flex-1 overflow-hidden min-w-0">
        {/* Topbar */}
        <div className="h-[52px] shrink-0 flex items-center gap-3 px-6
          bg-surface-1 border-b border-white/[0.06]">
          <div>
            <div className="text-[15px] font-semibold text-white tracking-tight">
              {TITLES[screen]}
            </div>
            <div className="text-[11px] text-white/25">Claims1 · PI2 2026</div>
          </div>
          <div className="ml-auto flex items-center gap-2">
            <div className="relative">
              <Search size={12} className="absolute left-2.5 top-1/2 -translate-y-1/2 text-white/25" />
              <input
                className="input-base !pl-7 !py-1.5 text-xs w-44"
                placeholder="Quick search…"
                value={gsearch}
                onChange={e => {
                  setGsearch(e.target.value)
                  if (e.target.value) setScreen('roster')
                }}
              />
            </div>
            <button className="btn-solid" onClick={() => openModalFor()}>
              <Plus size={13} /> Log leave
            </button>
          </div>
        </div>

        {/* Screen content */}
        <div className="flex-1 overflow-y-auto p-5">
          {screen === 'dashboard'    && <Dashboard    leaves={leaves} onLogLeave={openModalFor} />}
          {screen === 'calendar'     && <Calendar     leaves={leaves} onLogLeave={openModalFor} />}
          {screen === 'availability' && <Availability leaves={leaves} />}
          {screen === 'leaves'       && <AllLeaves    leaves={leaves} onDelete={handleDelete} />}
          {screen === 'roster'       && <Roster       leaves={leaves} searchOverride={gsearch} />}
        </div>
      </div>

      <LogLeaveModal
        open={modalOpen}
        onClose={() => setModalOpen(false)}
        onSave={handleSave}
        defaultEmp={defaultEmp}
      />
    </div>
  )
}
